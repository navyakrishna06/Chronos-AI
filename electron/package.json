{
  "name": "chronos-ai",
  "version": "1.0.0",
  "description": "Chronos AI - 3D Predictive Maintenance Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chronosai.predictive",
    "productName": "Chronos AI",

    "directories": {
      "output": "release"
    },

    "files": [
      "main.js",
      "package.json",
      "frontend/**/*"
    ],

    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],

    "win": {
      "target": "nsis"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chronos AI"
    }
  },

  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}